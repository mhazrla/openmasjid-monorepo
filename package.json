{
  "name": "openmasjid-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\" \"pnpm dev:web\" --names \"SERVER,ADMIN,GALLERY\" --prefix-colors \"blue,green,yellow\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter public-web dev",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter server build",
    "build:web": "pnpm --filter public-web build",
    "build": "concurrently \"pnpm build:client\" \"pnpm build:server\" \"pnpm build:web\"",
    "start": "pnpm --filter server start",
    "db:studio": "pnpm --filter server db:studio",
    "db": "pnpm --filter server db",
    "db:migrate:cli": "pnpm --filter server db:migrate:cli",
    "migrate": "pnpm --filter server migrate"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}