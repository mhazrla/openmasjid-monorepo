{
  "name": "openmasjid-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\" --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter server build",
    "build": "concurrently \"pnpm run build:client\" \"pnpm run build:server\"",
    "start": "pnpm --filter server start",
    "db:studio": "pnpm --filter server db:studio",
    "db": "pnpm --filter server db",
    "db:migrate:cli": "pnpm --filter server db:migrate:cli",
    "migrate": "pnpm --filter server migrate"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
